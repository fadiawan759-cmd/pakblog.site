rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && (
          request.auth.token.admin == true
          || (
            request.auth.token.email != null
            && request.auth.token.email in
              firestore.get(/databases/(default)/documents/settings/admins).data.emails
          )
        );
    }

    // Public article images may be displayed by readers, but only admins can upload/change them.
    match /articles-images/{articleId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    // Uploaded article HTML is never directly exposed to the public client.
    match /articles-html/{articleId}/{fileName} {
      allow read: if false;
      allow write: if isAdmin()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('text/html.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
